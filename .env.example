# ============================================================================
# Media Codex — environment reference
#
# This app has TWO deployment targets, each with its OWN set of env vars.
# Do not mix them up:
#   * FastAPI backend  → Render (codex-research-radar)  — sections A–I below
#   * Vercel edge fns  → Vercel project settings         — section Z at bottom
# ============================================================================


# ── A. Core (FastAPI / Render) ───────────────────────────────────────────────
APP_NAME="Codex Research Radar"
ENVIRONMENT=development          # set to "production" on Render
PORT=8080                        # Docker/Render port; local dev uses uvicorn 8000
# LOG_LEVEL=INFO

# Required when ENVIRONMENT=production (boot fails otherwise). Every mutating
# endpoint requires the X-Admin-Token header to match this value.
# ADMIN_TOKEN=change-me

# ── B. Database & storage (FastAPI / Render) ────────────────────────────────
# DATABASE_PATH=./data/research.db     # default: <repo>/data/research.db
# IMAGE_DIR=./data/images              # default: <repo>/data/images
# SQLITE_TIMEOUT_SECONDS=10
# SQLITE_BUSY_TIMEOUT_MS=10000

# ── C. Crawl schedule (FastAPI / Render) ────────────────────────────────────
CRAWL_INTERVAL_MINUTES=180
PER_QUERY_LIMIT=5
RUN_STARTUP_CRAWL=false
# Product guardrail: external scraping stays OFF unless explicitly enabled.
# The default product uses public-provider APIs / rights-authorized submissions.
ENABLE_EXTERNAL_CRAWLS=false

# ── D. CORS (FastAPI / Render) ──────────────────────────────────────────────
# Comma-separated exact origins allowed to call the API from a browser.
# Required in production — cross-origin access is disabled when unset.
CORS_ALLOW_ORIGINS="https://new-app-media-codex.vercel.app"
# Optional regex covering Vercel preview aliases of this project (C26). Defaults
# to ^https://new-app-media-codex(-[a-z0-9-]+)?\.vercel\.app$ — set empty to disable.
# CORS_ALLOW_ORIGIN_REGEX="^https://new-app-media-codex(-[a-z0-9-]+)?\.vercel\.app$"

# ── E. AI / assistant & hypotheses (FastAPI / Render) ───────────────────────
# Without a key the app uses built-in deterministic fallbacks.
# Any OpenAI-compatible API works (OpenAI, Groq, Together, Ollama, etc.)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── F. Media handling (FastAPI / Render) ────────────────────────────────────
# STREAM_ONLY_MEDIA=true (default) streams media and purges local caches on boot.
STREAM_ONLY_MEDIA=true
# SKIP_MEDIA_DOWNLOADS=true skips downloading media bodies during capture.
SKIP_MEDIA_DOWNLOADS=true
# ENABLE_IMAGE_DOWNLOADS=false (default) keeps poster/image downloads off.
# ENABLE_IMAGE_DOWNLOADS=false
# Max accepted upload size for user-posted videos, in megabytes.
UPLOAD_VIDEO_MAX_MB=500

# ── G. Outbound proxies (FastAPI / Render, all optional) ────────────────────
# Comma-separated HTTP/SOCKS proxy URLs for sources that route through a proxy.
# PROXY_LIST=
# Archiver proxy (self-hosted fetch proxy for authorized archive mirrors).
# ARCHIVER_PROXY_URL=              # base URL of your archiver proxy
# ARCHIVER_PROXY_HOSTS=            # comma-separated host allow-list routed via proxy
# ARCHIVER_PROXY_DISABLE_IMG=false # set true to never proxy image requests
# ARCHIVER_PROXY_MAX_ATTEMPTS=8
# ARCHIVER_PROXY_REQUEST_ATTEMPTS=4

# ── H. Observability & integrations (FastAPI / Render, optional) ────────────
# SENTRY_DSN=                      # enable Sentry error reporting
# PUBMED_API_KEY=                  # raises PubMed rate limits
# FIRECRAWL_API_KEY=               # optional web-scraping backend

# Credential-backed public discovery. These keys live on Render only; Vercel
# calls Render's normalized provider gateway and never receives key values.
X_BEARER_TOKEN=
TUMBLR_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Telegram channel scanning (MTProto via Pyrogram)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=           # generated by: python scripts/telegram_auth.py
TELEGRAM_SCAN_LIMIT=200

# ── I. Per-source result limits (FastAPI / Render) ──────────────────────────
REDDIT_RESULTS=4
X_RESULTS=4
LPSG_RESULTS=4
KEMONO_RESULTS=4
COOMER_RESULTS=4
PUBMED_RESULTS=6
BIORXIV_RESULTS=4
ARXIV_RESULTS=4
FIRECRAWL_RESULTS=5
ANECDOTE_RESULTS=6
IMAGE_RESULTS=8
REDGIFS_RESULTS=30
INSTAGRAM_RESULTS=8
FANSLY_RESULTS=8
JUSTFORFANS_RESULTS=8
YTDLP_RESULTS=8
# SPANKBANG_RESULTS=8
# BOYFRIENDTV_RESULTS=8
# MALE_VIDEO_ARCHIVER_RESULTS=24


# ============================================================================
# Z. VERCEL EDGE environment — set these in the VERCEL PROJECT, not on Render.
# ----------------------------------------------------------------------------
# The shipped /api/live-media path runs as Vercel edge functions (frontend/api/).
# Provider keys are deliberately absent here: credentialed calls are delegated
# to Render. This optional origin only changes the server-to-server target.
# ============================================================================
RENDER_BACKEND_ORIGIN=https://codex-research-radar.onrender.com
# Model used by the edge AI rerank via the AI Gateway. Pin a known-good model
# (audit A8): an unverifiable model makes every Scan silently fall back.
AI_DISCOVERY_MODEL=openai/gpt-4o-mini
# Vercel AI Gateway key (edge). By default the deployment OIDC token is used.
# AI_GATEWAY_API_KEY=

# --- Media ingestion (all optional) ---
# INGEST_DIR=data/ingested            # where processed uploads/imports live (served at /ingested-media)
# INGEST_IMAGE_MAX_MB=40
# INGEST_VIDEO_MAX_MB=1500
# INGEST_WORKERS=1
# INGEST_DOWNLOAD_VIDEOS=0            # 1 = mirror imported videos by default (needs disk)
# INGEST_NORMALIZE_VIDEO=1            # remux/transcode to H.264/AAC faststart when ffmpeg exists
# MEDIA_HLS_LADDER=0                  # 1 = also generate an HLS ladder for downloaded videos
# FFMPEG_PATH= / FFPROBE_PATH=        # override binary discovery
# MEDIA_INGEST_ALLOW_PRIVATE=0        # NEVER enable in production (disables SSRF protection; tests only)
# PROXY_CACHE_MAX_MB=64
# VIDEO_CACHE_MAX_MB=5000

# --- Persistent creator index (backend crawler; public sources only) ---
# CREATOR_INDEX_ENABLED=true            # false = no scheduled crawling (reads + admin endpoints still work). Always off when ENVIRONMENT=testing.
# CREATOR_INDEX_INTERVAL_MINUTES=45     # crawl cadence (min 5), jittered, never overlapping
# CREATOR_INDEX_MAX_PAGES=40            # hard cap of provider requests per run
# CREATOR_INDEX_MAX_SECONDS=240         # hard wall-clock cap per run
# Operator triggers (admin token): POST /api/v1/creators/index/crawl[?wait=true&source=redgifs|bluesky|mastodon|lemmy|peertube|feeds], POST /api/v1/creators/index/observe

# --- Creator-submitted feeds + takedown requests (public forms; app/creator_index/feeds.py, moderation.py) ---
# Public: POST /api/v1/creators/feeds/submit, POST /api/v1/creators/takedown (via the edge gateway or /api/feed-submit).
# Admin (X-Admin-Token): GET/POST /api/v1/creators/admin/{feeds,takedowns,suppressions,suppress,hidden,lanes,tags}
# PRIVACY_HASH_SALT=                    # secret salt for the HMAC digests of contact e-mails / client IPs (never stored raw). Unset = a random salt is generated once and kept in the DB.
# FEED_DENYLIST=                        # extra comma-separated hosts refused for submissions and crawling: `name.*` (any TLD), `*.example.com`, `example.com`. Built-in list (coomer.*, kemono.*, lpsg.com, ...) is in app/creator_index/feeds.py.
# FEED_SUBMIT_PER_HOUR=5                # submission attempts per visitor per hour (failed probes count too)
# FEED_SUBMIT_GLOBAL_PER_HOUR=60        # global ceiling on submission attempts per hour
# FEED_MAX_PENDING=200                  # cap on feeds waiting for review
# FEED_REFRESH_MINUTES=360              # re-fetch interval of an approved feed (failures back off exponentially)
# FEED_MAX_PER_RUN=6                    # approved feeds fetched per crawl run (own cap, at most 2 requests each; 0 = off)
# FEED_MAX_FAILURES=6                   # consecutive failures before an approved feed is paused
# TAKEDOWN_PER_HOUR=6                   # takedown requests per visitor per hour
# TAKEDOWN_GLOBAL_PER_HOUR=120          # global ceiling per hour
# TAKEDOWN_PER_EMAIL_PER_DAY=20         # per contact (hashed) per day
# TRUST_GATEWAY_CLIENT_IP=true          # honour X-Client-IP set by the Vercel gateway (visitor address for per-visitor limits); 0 = use the socket peer
# GATEWAY_CLIENT_IP_SECRET=            # set the SAME value on Render and Vercel: X-Client-IP is then only trusted from requests carrying it (stops direct callers spoofing per-visitor limits)

# --- Wider discovery + adaptive lanes (all optional) ---
# MASTODON_EXTRA_INSTANCES=             # comma-separated extra instances whose public tag timelines are crawled
# MASTODON_TAG_PAGES=3                  # follow Link: rel=next up to this many pages per tag timeline (also bounded by the run budget)
# LEMMY_EXTRA_INSTANCES=                # extra Lemmy instances (public search + community listing)
# LEMMY_MAX_COMMUNITIES=6               # discovered NSFW communities crawled per run
# PEERTUBE_EXTRA_HOSTS=                 # extra sepiasearch-compatible PeerTube search hosts
# REDGIFS_MAX_NICHES=24                 # niches kept from the provider's public niche listing (probe is skipped when unavailable)
# REDGIFS_NICHE_REFRESH_HOURS=24        # re-probe interval when the niche listing works
# REDGIFS_NICHE_RETRY_DAYS=7            # re-probe interval when it does not
# TAG_SNOWBALL_MIN_ITEMS=8              # related tag must appear on this many items of high-engagement creators before it becomes a lane
# TAG_SNOWBALL_MIN_SCORE=45             # curation score (0-100) that makes a creator "high engagement"
# TAG_SNOWBALL_MAX_LANES=30             # cap on promoted related-tag lanes
# TAG_SNOWBALL_PER_RUN=4                # new lanes promoted per run
# LANE_BACKOFF_AFTER=3                  # runs with zero new creators before a lane backs off
# LANE_BACKOFF_BASE_HOURS=3             # first back-off; doubles each further zero-yield run
# LANE_BACKOFF_MAX_HOURS=168            # back-off ceiling
