{
  "name": "Media Codex",
  "short_name": "MediaCodex",
  "description": "Private, explainable discovery across public creator sources",
  "start_url": "/media",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "background_color": "#0c0912",
  "theme_color": "#0c0912",
  "orientation": "any",
  "categories": ["entertainment", "utilities"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    { "name": "Library", "url": "/media", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Search", "url": "/search", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Creators", "url": "/creators", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/search",
    "method": "GET",
    "params": { "url": "url", "text": "q" }
  }
}
