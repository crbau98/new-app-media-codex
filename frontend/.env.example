# Backend API origin (no trailing slash)
# Leave empty for same-origin, or set when UI is hosted separately
VITE_BACKEND_ORIGIN=https://codex-research-radar.onrender.com

# Server-side Vercel discovery integrations (never prefix these with VITE_)
# AI Gateway uses Vercel OIDC in deployments; a static key is optional.
AI_DISCOVERY_MODEL=openai/gpt-5.4
# AI_GATEWAY_API_KEY=

# Official platform APIs (server-side only)
# X_BEARER_TOKEN=
# TUMBLR_API_KEY=
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ID=

# SerpApi — powers Google Images and DuckDuckGo discovery adapters.
# Obtain at https://serpapi.com/ — rotate immediately if compromised.
# SERPAPI_API_KEY=

# Firecrawl — used for OG metadata enrichment of public creator profile pages.
# Obtain at https://www.firecrawl.dev/ — rotate immediately if compromised.
# FIRECRAWL_API_KEY=
