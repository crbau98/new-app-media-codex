# Render target for Vercel server functions and the local Vite proxy.
# This is public configuration, not a credential.
RENDER_BACKEND_ORIGIN=https://codex-research-radar.onrender.com

# Optional browser override for non-Vercel split deployments only. Vercel
# always uses /api/render so browser API traffic remains same-origin.
# VITE_BACKEND_ORIGIN=https://codex-research-radar.onrender.com

# Server-side Vercel discovery integrations (never prefix these with VITE_)
# AI Gateway uses Vercel OIDC in deployments; a static key is optional.
AI_DISCOVERY_MODEL=openai/gpt-5.4
# AI_GATEWAY_API_KEY=
